---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectItem from '../ProjectItem.astro';
import { projects } from '../../data/projects';
import { messages, type Locale } from '../../utils/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = messages[lang];
---

<BaseLayout lang={lang} title={t.projects} description={t.projectsDescription}>
  <h1>{t.projects}</h1>
  <p class="page-description">{t.projectsIntro}</p>
  {projects.length ? (
    <ul class="project-list">
      {projects.map((project) => (
        <ProjectItem project={project} lang={lang} />
      ))}
    </ul>
  ) : (
    <div class="empty-state">
      <span class="i-lucide-folder-open empty-icon" aria-hidden="true"></span>
      <h2>{t.noProjects}</h2>
      <p>{t.noProjectsHint}</p>
    </div>
  )}
</BaseLayout>
