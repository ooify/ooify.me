---
import { switchPath, type Locale } from '../utils/i18n';
interface Props {
  lang: Locale;
  alternate?: string;
}
const { lang, alternate } = Astro.props;
const target = lang === 'zh' ? 'en' : 'zh';
---

<a
  class="language-switcher"
  href={alternate ?? switchPath(Astro.url.pathname, lang)}
  lang={target === 'zh' ? 'zh-CN' : 'en'}
  aria-label={lang === 'zh' ? 'Switch to English' : '切换到中文'}
  title={lang === 'zh' ? 'Switch to English' : '切换到中文'}
  data-astro-prefetch
>
  {lang === 'zh' ? 'EN' : '中'}
</a>
